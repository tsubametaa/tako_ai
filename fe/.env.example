# Port Frontend Node/Vite
PORT=1234

# URL Backend Golang untuk request dari Browser (Frontend -> Backend)
# Lokal: http://127.0.0.1:5000/api/v1 (atau /api/v1 jika lewat proxy)
# Produksi VPS: https://api.utaaa.io/api/v1 (atau /api/v1 jika satu domain lewat Nginx)
PUBLIC_API_BASE_URL=http://127.0.0.1:5000/api/v1

# Target Backend Golang untuk SSR SvelteKit & Vite Dev Proxy
INTERNAL_API_BASE_URL=http://127.0.0.1:5000
