    "@tsconfig/svelte": "^5.0.8",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^24.13.3",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.70.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.3"
