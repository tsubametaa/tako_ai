# Server
PORT=5000
GIN_MODE=release

# CORS (pisahkan dengan koma jika lebih dari satu origin)
FRONTEND_ORIGINS=https://ai.utaaa.io,https://chat.utaaa.io,https://admin.utaaa.io,https://auth.utaaa.io,http://localhost:1234,http://127.0.0.1:1234

# Supabase Postgres (gunakan ?sslmode=require; :6543 otomatis memakai simple_protocol)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.example.supabase.co:5432/postgres?sslmode=require

# Redis (Rate Limiting, JWT Logout Blacklist, & Buffer Event SSE)
REDIS_URL=redis://localhost:6379/0

# JWT Auth
JWT_SECRET=ganti-dengan-secret-minimal-32-karakter-yang-aman
JWT_TTL=24h

# Python AI Microservice (kka_lab)
AI_BASE_URL=http://127.0.0.1:8000
AI_INTERNAL_SECRET=ganti-dengan-ai-internal-secret
RAG_ADMIN_SECRET=ganti-dengan-rag-admin-secret

# DataStax Astra DB Cloud (Penyimpanan Conversations, Messages/Exchanges, & Persona)
ASTRA_DB_API_ENDPOINT=https://<ID-DATABASE>-<REGION>.apps.astra.datastax.com
ASTRA_DB_APPLICATION_TOKEN=AstraCS:xxxxxxxxxxxxxxxxxxxxxxxx
ASTRA_DB_KEYSPACE=rag
ASTRA_DB_CHAT_COLLECTION=chat_history

# Concurrency, Rate Limit & Timeout
CHAT_RATE_LIMIT_PER_MIN=15
MAX_INFLIGHT_CHAT=35
CHAT_QUEUE_WAIT=5s
CHAT_AI_TIMEOUT=90s
MAX_INFLIGHT_RAG_UPLOAD=3
RAG_QUEUE_WAIT=10s
RAG_UPLOAD_TIMEOUT=30s
DEFAULT_AI_TIMEOUT=10s
MAX_UPLOAD_BYTES=22020096
SSE_EVENT_TTL=30m

